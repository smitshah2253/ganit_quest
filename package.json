{
  "name": "ganitquest-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "build:shared": "npm run build --workspace=@ganitquest/shared",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "test": "npm run test --workspaces --if-present"
  }
}
